# Copy to .env and fill in. .env is gitignored. See docs/DEPLOYMENT.md for what
# each variable does and which service reads it.

# --- Vendor API keys (gateway: STT/TTS; brain: transliteration) ---
SARVAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=

# --- S3 (recorder uploads full_call.mp4; brain uploads transcripts) ---
AWS_S3_BUCKET=
AWS_MEDIA_FOLDER=          # key prefix, e.g. recordings (blank = bucket root)
AWS_REGION=               # e.g. ap-south-1
AWS_URL=                  # public/CDN base for object URLs, e.g. https://cdn.example.com
# Credentials: leave blank on EC2 to use the instance IAM role; set for local/off-EC2.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- TURN / coturn (prod NAT traversal; blank on localhost) ---
TURN_URL=                 # e.g. turn:turn.example.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=
